{
  "nodes": [
    {"id": "docs_mockups_chamados_v2_desktop", "label": "Chamados v2 · desktop — 'Fila de chamados' (Coordenação) como board por status; header MOCKUP indica direção 'board por status — três colunas (aberto → em atendimento → resolvido) e o detalhe que expande dentro do próprio card'", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v2-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v2_desktop_board_por_status", "label": "Board por status: três colunas Aberto (aguardando triagem, 'mais antigo há 1 d', realce vermelho) → Em atendimento (com responsável designado) → Resolvido (últimos 30 dias); contadores no topo '3 aguardando triagem / 2 em atendimento / 2 resolvidos'", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v2-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v2_desktop_card_contexto", "label": "Card de chamado com contexto: protocolo CHA-000XXX, título, autor com marcador de papel (mentor/mentorada), dupla e turma (ex.: 'Beatriz × Sérgio · T1'), pílula de categoria, idade do chamado e responsável ou pílula tracejada 'Sem responsável'; resolvido traz resumo da solução e 'Reabrir chamado'", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v2-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v2_desktop_detalhe_inline", "label": "Detalhe que expande inline dentro do próprio card: solicitação original em citação ('Enviado por Beatriz pelo botão \"pedir apoio\" na ficha da dupla'), timeline público × comentário interno ('só a equipe vê') e ações 'Assumir chamado', 'Atribuir a…', 'Resolver' — sem sair do board", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v2-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v2_desktop_urgencia_categoria", "label": "Urgência é categoria, não coluna: pílula vermelha + filtro 'Urgência 1'; notifica coordenação e supervisão, que disputam quem assume primeiro", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v2-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v2_desktop_filtros", "label": "Barra de filtros: Categoria (Todas 7, Urgência 1, Agenda 2, Metodologia 2, Plataforma 1, Outro 1), 'Responsável: todos' e toggle 'Só sem dono'", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v2-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v2_mobile", "label": "Chamados v2 · mobile — mesma fila em largura estreita; as três colunas viram abas por status 'Abertos 3 / Em atend. 2 / Resolvidos 2' e o card expandido mantém timeline e ações empilhadas", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v2-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v2_mobile_abas_status", "label": "Abas por status no mobile implementadas como radios em CSS puro (conforme nota do rodapé: 'no mobile, as colunas viram abas por status')", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v2-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v3_desktop", "label": "Chamados v3 · desktop — direção 'inbox denso ordenado pela última movimentação + detalhe em página cheia — direção vencedora da rodada 1'; tela 'Chamados' (7 na fila · 3 abertos sem dono) + TELA 2 detalhe CHA-000137", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v3-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v3_desktop_inbox_denso", "label": "Inbox denso: uma linha por chamado ordenada pela última movimentação — protocolo, selo 'NOVO', categoria, autor com papel, dupla com semáforo próprio, prévia da última atualização, status (Aberto/sem dono, Em atendimento, Resolvido) e avatar do dono", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v3-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v3_desktop_detalhe_pagina_cheia", "label": "Detalhe em página cheia (abre ao tocar na linha): ficha com Autor, Dupla (link para a ficha), Abertura, Última atualização e Acompanhando (supervisora), mais ações Assumir / Atribuir… / Resolver / Reabrir", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v3-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v3_desktop_timeline_intercalada", "label": "Timeline intercalada: mensagem original com anexo (NF-008614.pdf), atualizações públicas automáticas e comentários internos em âmbar tracejado com @menção — cada evento sinalizado pela tag 'público' × 'interno'", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v3-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v3_desktop_composer_publico_padrao", "label": "Composer 'Público é o padrão': abas 'Atualização pública' (autor recebe por e-mail e no app) e 'Comentário interno'; campo com 'Use @ para chamar alguém da equipe'; botões 'Enviar e resolver' e 'Enviar atualização'", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v3-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v3_desktop_filtros_trabalho", "label": "Filtro por trabalho: além de categoria e status, a barra traz 'Sem dono' e 'Atribuídos a mim' — recortes que organizam o dia da equipe — e busca por protocolo, nome ou dupla", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v3-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v3_mobile", "label": "Chamados v3 · mobile — inbox densa + detalhe em página cheia empilhados; mesma linha de chamado, timeline público×interno e composer com 'Enviar atualização'", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v3-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v4_desktop", "label": "Chamados v4 · desktop — direção 'master-detail — fila + detalhe lado a lado (desktop), inbox + página cheia (mobile); vermelho só sem dono; interno por padrão; plataforma só coordenação'; inclui matriz papel×vê×pode, regras visuais/de domínio, rastreabilidade e decisões em aberto", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v4-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v4_desktop_master_detail", "label": "Master-detail: coluna esquerda com a fila (8 chamados, seleção por linha, alertas 'Mais antigo sem dono: há 3 d · CHA-000137' e 'Mais antigo em atendimento: há 4 d'), coluna direita com o detalhe completo do chamado selecionado (CHA-000143 'Caio não responde há 9 dias e o encontro 5 é amanhã')", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v4-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v4_desktop_ver_como", "label": "Switcher de simulação 'Ver como': Coordenação / Auxiliar executivo / Mentor / Mentorado, 'Estado: Com chamados / Vazio' e botões Diálogo/Notas — o diálogo de abertura abre por 'Abrir chamado'/'Pedir apoio'", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v4-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v4_desktop_banner_permissoes", "label": "Banner de permissões por papel: 'Você vê: a fila completa — todas as categorias, inclusive plataforma — e a linha do tempo pública + interna. Você pode: assumir, atribuir, resolver, reabrir, devolver à fila. Não existe: \"agendar pela dupla\".'", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v4-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v4_desktop_matriz_papeis", "label": "Matriz 'PAPEL × O QUE VÊ × O QUE PODE FAZER': Coordenação·Marina Costa (fila completa, assume/atribui/publica, não agenda pela dupla), Auxiliar executivo·Paula Nunes (tudo menos plataforma bloqueada), Mentor DPP/especialista ('Meus chamados', abre 5 categorias, não vê internos nem a fila), Mentorado (só os próprios pedidos)", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v4-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v4_desktop_composer_interno_padrao", "label": "Composer com 'Comentário interno' como padrão (âmbar tracejado, 'só a equipe vê; André não é notificado') e 'Atualização pública' como alternância — inversão deliberada em relação ao v3; botão 'Comentar internamente' + 'Anexar arquivo'", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v4-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v4_desktop_linha_do_tempo", "label": "Linha do tempo intercalada com legenda explícita: Público (o autor vê e é notificado) · Interno (só a equipe) · Automático (eventos do sistema, públicos) — ex.: 'Urgência: Marina Costa e Paula Nunes foram notificadas (e-mail + app)'", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v4-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v4_desktop_filtros_fila", "label": "Cabeçalho da fila: busca por protocolo/autor/dupla ou assunto; filtros FILA (Todos 8 · Sem dono 3 · Atribuídos a mim 3), CATEGORIA e STATUS; pílulas de status por linha 'Aberto · sem dono' / 'Em atendimento · Marina' / 'Resolvido'", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v4-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v4_desktop_regras_dominio", "label": "Regras visuais e de domínio: vermelho só enquanto ninguém assumiu; comentário interno é o padrão; 'Preciso de apoio' no registro abre chamado automático; urgência notifica coordenação + supervisão ao mesmo tempo; 'Estado: Vazio' mostra inbox zerada (coord/aux) e 'nenhum chamado' (mentor/mentorado)", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v4-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v4_desktop_decisoes_abertas", "label": "Decisões em aberto: atualização pública de quem não é dono assume o chamado? autor pode reabrir sozinho ou só 'pedir reabertura'? categoria automática do registro = sempre urgência? auxiliar vê chamados de duplas fora das 6 supervisionadas? SLA sem dono escala por e-mail? mentorado/mentor anexam arquivos?", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v4-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v4_desktop_v1_master_detail_legado", "label": "Herança do v1 (mockup anterior fora deste lote): master-detail em duas colunas no desktop e legenda público×interno — citado na rastreabilidade do v4", "file_type": "concept", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v4-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_mockups_chamados_v4_mobile", "label": "Chamados v4 · mobile — 'inbox + página cheia': switcher 'Ver como', banner de permissões, fila em lista única com seleção e, abaixo, matriz de papéis/regras/rastreabilidade empilhadas", "file_type": "image", "source_file": "/home/thiago/nb/realiza.vc/docs/mockups/chamados/v4-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}
